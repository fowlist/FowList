TRUNCATE TABLE support_DB;

INSERT INTO support_DB

    SELECT  
            support_Structure.formation AS formation, 
            support_Structure.box_nr AS box_nr,  
            support_Structure.box_type AS box_type, 
            support_Structure.platoon AS platoon, 
            support_Structure.title AS title, 
            support_Structure.unitType AS unitType, 
            formations.code AS code, 
            formations.Book AS Book, 
            support_Structure.box_nr AS ogBoxNr,
            support_Structure.motivSkillHitOn AS motivSkillHitOn,
            support_Structure.prerequisite AS prerequisite
    FROM    support_Structure 
    LEFT    JOIN    formations 
        ON      formations.code = support_Structure.formation
    WHERE   formations.title LIKE '%Support%';

    TRUNCATE TABLE formationSupport_DB;

INSERT INTO formationSupport_DB
SELECT
	DISTINCT 
    nationBooks.Book,
    nb.Book AS alliedBook,
    formation_DB.formation AS formation, formation_DB.platoon , formation_DB.title AS title, formation_DB.unitType, formation_DB.box_type AS box_type, nb.Nation AS Nation,
	(FIND_IN_SET(nationBooks.Book, nb.Book) + FIND_IN_SET(nationBooks.Nation, nb.Nation)) AS relevance,  formation_DB.motivSkillHitOn AS motivSkillHitOn
FROM
    nationBooks
LEFT JOIN
    nationBooks AS nb 
    ON 
    nb.period = nationBooks.period
    AND 
    (nb.Nation = nationBooks.Nation
    OR
    nb.Allies LIKE CONCAT('%', nationBooks.Nation, '%'))
LEFT JOIN 
  	formations
    ON 
    nb.Book = formations.Book
LEFT JOIN
    formation_DB
    ON
    formations.code = formation_DB.formation
WHERE
	formations.code NOT LIKE '%Support%'
    AND
    formation_DB.BlackBox = 1
    AND
    formations.code NOT LIKE '%CC%'
ORDER BY 
relevance DESC,
formation_DB.box_type ASC,
nationBooks.Book;



TRUNCATE TABLE platoonConfigDB;

INSERT INTO platoonConfigDB
        SELECT  platoonConfig.* , unitT.unitType AS unitType , unitT.formation AS formation
    FROM    platoonConfig
    left    JOIN    (   SELECT DISTINCT unitType, platoon, formation
                        FROM formation_DB )
                    AS
                    unitT
            ON unitT.platoon = platoonConfig.platoon;


TRUNCATE TABLE platoonConfigSupportDB;

INSERT INTO platoonConfigSupportDB

    SELECT  platoonConfig.* , unitT.unitType AS unitType, unitT.formation AS formation, Book
    FROM    platoonConfig
    INNER    JOIN    (   
        SELECT DISTINCT unitType, platoon, formation, Book
        FROM support_DB )
        AS unitT
    ON unitT.platoon = platoonConfig.platoon;