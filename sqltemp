    TRUNCATE TABLE alliedFormations;

INSERT INTO alliedFormations
SELECT
	DISTINCT 
    nationBooks.Book AS currentBook,
    formations.*
FROM
    nationBooks
LEFT JOIN
    nationBooks AS nb 
    ON 
    nb.period = nationBooks.period
    AND 
    (nb.Nation = nationBooks.Nation
    OR
    nb.Allies LIKE CONCAT('%', nationBooks.Nation, '%'))
LEFT JOIN 
  	formations
    ON 
    nb.Book = formations.Book
WHERE
	formations.code NOT LIKE '%Support%'
ORDER BY
currentBook,
formations.Book;

